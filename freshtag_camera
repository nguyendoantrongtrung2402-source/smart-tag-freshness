<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<style>
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:transparent;color:#fff;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  .shell{
    position:relative;width:100%;height:min(72vh,620px);min-height:390px;
    overflow:hidden;border-radius:26px;background:#050306;
    border:1px solid rgba(255,255,255,.12);
    box-shadow:0 26px 70px rgba(0,0,0,.34);
  }
  video{width:100%;height:100%;object-fit:cover;background:#030204;display:block}
  .shade{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(5,3,7,.22),transparent 24%,transparent 70%,rgba(5,3,7,.48))}
  .guide{
    position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);
    width:min(64vw,300px);aspect-ratio:1.4/1;border:2px solid rgba(255,255,255,.72);
    border-radius:18px;box-shadow:0 0 0 999px rgba(11,4,14,.10);
    pointer-events:none;
  }
  .guide:before,.guide:after{
    content:"";position:absolute;width:28px;height:28px;border-color:#d28ada;border-style:solid
  }
  .guide:before{left:-2px;top:-2px;border-width:4px 0 0 4px;border-radius:15px 0 0 0}
  .guide:after{right:-2px;bottom:-2px;border-width:0 4px 4px 0;border-radius:0 0 15px 0}
  .guide-label{
    position:absolute;left:50%;top:calc(48% - min(23vw,105px));transform:translate(-50%,-100%);
    padding:7px 11px;border-radius:999px;background:rgba(17,8,20,.55);backdrop-filter:blur(12px);
    font-size:12px;font-weight:750;letter-spacing:.02em;white-space:nowrap;color:rgba(255,255,255,.86)
  }
  .controls{
    position:absolute;left:0;right:0;bottom:max(18px,env(safe-area-inset-bottom));
    display:flex;align-items:center;justify-content:center;z-index:4
  }
  .shutter{
    width:76px;height:76px;border-radius:50%;border:3px solid rgba(255,255,255,.96);
    background:rgba(255,255,255,.13);padding:6px;cursor:pointer;
    box-shadow:0 8px 28px rgba(0,0,0,.38);transition:transform .12s ease
  }
  .shutter:active{transform:scale(.94)}
  .shutter span{display:block;width:100%;height:100%;border-radius:50%;background:#fff}
  .status{
    position:absolute;left:14px;right:14px;top:14px;z-index:5;
    padding:11px 13px;border-radius:15px;background:rgba(20,8,24,.70);
    border:1px solid rgba(255,255,255,.11);backdrop-filter:blur(14px);
    font-size:13px;line-height:1.4;text-align:center
  }
  .error .shutter{display:none}
  canvas{display:none}
  @media(max-width:520px){
    .shell{height:62vh;min-height:420px;border-radius:22px}
    .guide{width:72vw}
  }
</style>
</head>
<body>
<div class="shell" id="shell">
  <video id="video" autoplay playsinline muted></video>
  <canvas id="canvas"></canvas>
  <div class="shade"></div>
  <div class="guide"></div>
  <div class="guide-label">Đặt thẻ vào trong khung</div>
  <div class="status" id="status">Đang yêu cầu quyền truy cập camera…</div>
  <div class="controls">
    <button class="shutter" id="shutter" aria-label="Chụp ảnh"><span></span></button>
  </div>
</div>

<script>
(function(){
  const STREAMLIT = "streamlit:";
  let stream = null;
  let started = false;
  const video = document.getElementById("video");
  const canvas = document.getElementById("canvas");
  const status = document.getElementById("status");
  const shell = document.getElementById("shell");
  const shutter = document.getElementById("shutter");

  function post(type, payload={}){
    window.parent.postMessage(Object.assign({
      isStreamlitMessage:true,
      type:STREAMLIT + type
    }, payload), "*");
  }

  function setHeight(){
    post("setFrameHeight", {height: document.documentElement.scrollHeight});
  }

  function setValue(value){
    post("setComponentValue", {value:value, dataType:"json"});
  }

  function friendlyError(err){
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia)
      return "Trình duyệt này không hỗ trợ camera trực tiếp.";
    if (err && err.name === "NotAllowedError")
      return "Bạn chưa cho phép truy cập camera. Hãy bật quyền Camera cho trang này rồi tải lại.";
    if (err && err.name === "NotFoundError")
      return "Không tìm thấy camera trên thiết bị.";
    if (err && err.name === "NotReadableError")
      return "Camera đang được ứng dụng khác sử dụng.";
    return "Không thể mở camera. Hãy kiểm tra quyền Camera của trình duyệt.";
  }

  async function startCamera(){
    if(started) return;
    started = true;
    try{
      status.textContent = "Đang mở camera…";
      const constraints = {
        audio:false,
        video:{
          facingMode:{ideal:"environment"},
          width:{ideal:1920},
          height:{ideal:1080}
        }
      };
      stream = await navigator.mediaDevices.getUserMedia(constraints);
      video.srcObject = stream;
      await video.play();
      status.style.display = "none";
      setHeight();
    }catch(err){
      shell.classList.add("error");
      status.textContent = friendlyError(err);
      status.style.display = "block";
      setHeight();
    }
  }

  function stopCamera(){
    if(stream){
      stream.getTracks().forEach(t => t.stop());
      stream = null;
    }
  }

  shutter.addEventListener("click", function(){
    if(!video.videoWidth || !video.videoHeight) return;
    shutter.disabled = true;

    const maxW = 1600;
    const scale = Math.min(1, maxW / video.videoWidth);
    canvas.width = Math.round(video.videoWidth * scale);
    canvas.height = Math.round(video.videoHeight * scale);

    const ctx = canvas.getContext("2d");
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

    const jpg = canvas.toDataURL("image/jpeg", 0.90);
    status.textContent = "Đã chụp · Đang phân tích…";
    status.style.display = "block";
    stopCamera();
    setValue(jpg);
  });

  window.addEventListener("message", function(event){
    if(!event.data || !event.data.isStreamlitMessage) return;
    if(event.data.type === STREAMLIT + "render"){
      startCamera();
      setHeight();
    }
  });

  window.addEventListener("beforeunload", stopCamera);

  post("componentReady", {apiVersion:1});
  setHeight();
})();
</script>
</body>
</html>
